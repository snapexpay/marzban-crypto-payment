SNAPEX_API_KEY=smk_...
SNAPEX_WEBHOOK_SECRET=whsec_...
SNAPEX_API_URL=https://snapex.pro/api/v1/merchant
SNAPEX_ENVIRONMENT=live
SNAPEX_FEE_ON=merchant
# Optional: Partner ID of the integrator who set this up (SnapEX Pay referral program)
SNAPEX_PARTNER_ID=
SNAPEX_EXPIRES_MINUTES=60
SNAPEX_USER_AGENT=SnapEX-Pay-Marzban/1.1.0

# Required: bearer token your bot/site sends to /v1/checkout and /v1/orders (openssl rand -hex 32). Empty = those endpoints answer 503.
API_TOKEN=

MARZBAN_URL=https://panel.example.com
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=change-me
# Or a ready token instead of username/password:
# MARZBAN_TOKEN=
# Public origin for relative /sub/<token> links (when Marzban's XRAY_SUBSCRIPTION_URL_PREFIX is empty).
# Defaults to MARZBAN_URL.
# MARZBAN_SUB_URL=https://sub.example.com

# id:days:usd:traffic_bytes (0 = unlimited)
PLANS=month:30:5.00:0,quarter:90:12.00:0,year:365:36.00:0
# PORT is used by `python -m app.main`; the Docker image always listens on 8080.
PORT=8080
DATA_DIR=/data
